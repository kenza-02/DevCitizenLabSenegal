---
import Layout from '~/layouts/PageLayout.astro';
import PageBanner from '~/components/widgets/PageBanner.astro';
import backgroundImage from '~/assets/images/Partenaire.jpg';
import { FaArrowRightLong, FaArrowUpRightFromSquare } from "react-icons/fa6";
import { FaChartLine, FaBrain, FaLightbulb, FaBullhorn } from "react-icons/fa";
import { FiFacebook, FiInstagram, FiTwitter } from "react-icons/fi";

const metadata = {
  title: 'Nos Partenaires - AfricTivistes CitizenLab Sénégal',
  description: 'Découvrez les organisations et institutions qui soutiennent notre mission pour promouvoir la démocratie participative et la citoyenneté active au Sénégal.',
  ignoreTitleTemplate: true,
};

const partners = [
  {
    name: 'AfricTivistes',
    href: 'https://www.africtivistes.com/fr/',
    logo: 'https://update.africtivistes.org/wp-content/uploads/2023/10/Logo-Africtivistes.png',
    description: 'Organisation panafricaine pour la promotion de la démocratie et des droits humains à travers les technologies civiques et l\'innovation citoyenne.',
    social: {
      facebook: 'https://www.facebook.com/AfricTivistes',
      instagram: 'https://www.instagram.com/africtivistes',
      twitter: 'https://twitter.com/AfricTivistes',
    }
  },
  {
    name: 'Union Européenne',
    href: 'https://international-partnerships.ec.europa.eu/index_fr',
    logo: 'https://citizenlab.africtivistes.org/cameroun/wp-content/uploads/sites/2/2025/04/logoue.png',
    description: 'Soutien financier et technique aux initiatives de développement durable et de gouvernance démocratique à travers ses partenariats internationaux.',
    social: {
      facebook: 'https://www.facebook.com/EuropeanCommission',
      instagram: 'https://www.instagram.com/europeancommission',
      twitter: 'https://twitter.com/EU_Commission'
    }
  },
  {
    name: 'Youth Democracy Cohort',
    href: 'https://youthdemocracycohort.com/',
    logo: 'https://citizenlab.africtivistes.org/cameroun/wp-content/uploads/sites/2/2025/04/logoydc.png',
    description: 'Réseau de jeunes leaders africains engagés dans la promotion de la démocratie participative et l\'innovation civique à travers le continent.',
    social: {
      facebook: 'https://www.facebook.com/YouthDemocracyCohort',
      instagram: 'https://www.instagram.com/youthdemocracycohort',
      twitter: 'https://twitter.com/YDCohort',
    }
  }
];

const benefits = [
  {
    title: 'Impact amplifié',
    description: 'Multipliez votre impact en collaborant avec un réseau d\'acteurs engagés pour la transformation démocratique.',
    icon: FaChartLine,
  },
  {
    title: 'Expertise partagée',
    description: 'Bénéficiez de l\'expertise collective et contribuez à enrichir les connaissances du réseau.',
    icon: FaBrain,
  },
  {
    title: 'Innovation continue',
    description: 'Co-créez des solutions innovantes pour répondre aux défis démocratiques contemporains.',
    icon: FaLightbulb,
  },
  {
    title: 'Visibilité renforcée',
    description: 'Augmentez votre influence en étant associé à une initiative citoyenne reconnue et impactante.',
    icon: FaBullhorn,
  },
];
---

<Layout metadata={metadata}>
  <!-- Banner -->
  <PageBanner
    image={backgroundImage}
    alt="Nos Partenaires"
    label="Partenariats"
    title="Nos Partenaires"
    description="Ensemble, nous construisons un Sénégal plus démocratique à travers des collaborations stratégiques et des initiatives citoyennes."
  />

  <section class="py-16 bg-white/90 backdrop-blur-sm">
  <!-- Partenaires -->
  <div class="">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
        <div>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 uppercase tracking-widest mb-2">
            Ils nous font confiance
          </span>
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
            Nos <span class="text-green-600">partenaires</span>
          </h2>
        </div>
        <p class="text-mutad-foreground text-gray-500 md:text-right md:max-w-xs leading-relaxed">
          Les organisations qui partagent notre vision d'une démocratie inclusive
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {partners.map((partner) => (
          <div class="bg-white border border-gray-100 hover:border-green-200 rounded-2xl overflow-hidden transition-colors duration-200 flex flex-col">
            <!-- Logo -->
            <div class="p-6 flex items-center justify-center h-24 border-b border-gray-50 bg-gray-50/50">
              <a href={partner.href} target="_blank" rel="noopener noreferrer">
                <img src={partner.logo} alt={partner.name} class="max-h-12 object-contain" />
              </a>
            </div>

            <!-- Contenu -->
            <div class="p-5 flex flex-col flex-1">
              <h3 class="text-sm font-semibold text-gray-900 mb-2">{partner.name}</h3>
              <p class="text-sm text-gray-500 leading-relaxed line-clamp-3 flex-1">
                {partner.description}
              </p>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between px-5 py-3 border-t border-gray-50">
              <div class="flex items-center gap-3">
                {partner.social.facebook && (
                  <a href={partner.social.facebook} target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-green-600 transition-colors">
                    <FiFacebook className="w-4.5 h-4.5" />
                  </a>
                )}
                {partner.social.instagram && (
                  <a href={partner.social.instagram} target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-green-600 transition-colors">
                    <FiInstagram className="w-4.5 h-4.5" />
                  </a>
                )}
                {partner.social.twitter && (
                  <a href={partner.social.twitter} target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-green-600 transition-colors">
                    <FiTwitter className="w-4.5 h-4.5" />
                  </a>
                )}
              </div>
              <a
                href={partner.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs font-medium text-green-700 hover:text-green-900 transition-colors"
              >
                Visiter
                <FaArrowUpRightFromSquare className="w-3 h-3" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Pourquoi devenir partenaire -->
  <div class="py-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-center text-2xl md:text-3xl font-bold text-gray-900 mb-3">
          Pourquoi devenir <span class="text-green-600">partenaire</span> ?
        </h2>
        <p class="text-muted-foreground text-center text-gray-500 max-w-xl mx-auto">
          Rejoignez un écosystème d'organisations engagées pour un impact collectif
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {benefits.map((benefit) => (
          <div class="bg-white border  hover:border-green-200 rounded-2xl p-5 flex items-start gap-4 transition-colors duration-200">
            <div class="w-10 h-10 rounded-xl bg-green-50 border border-green-100 flex items-center justify-center text-green-700 shrink-0">
              <benefit.icon className="w-4 h-4" />
            </div>
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-1">{benefit.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{benefit.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="max-w-7xlmx-auto px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-green-700 to-green-800">
      <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/5"></div>
      <div class="absolute -bottom-8 -left-8 w-28 h-28 rounded-full bg-white/[0.03]"></div>

      <div class="relative z-10 px-6 md:px-12 py-12 md:py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-xl">
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">
            Prêt à nous rejoindre ?
          </h2>
          <p class="text-sm text-green-200 leading-relaxed">
            Que vous soyez une organisation, une institution ou un particulier, votre contribution compte.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-white text-green-800 text-sm font-semibold rounded-lg hover:bg-green-50 transition-colors"
          >
            Nous contacter
            <FaArrowRightLong className="w-3.5 h-3.5" />
          </a>
          <a
            href="/a-propos"
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 border border-white/30 text-white text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors"
          >
            En savoir plus
          </a>
        </div>
      </div>
    </div>
  </div>
  </section>
</Layout>