---
import Layout from "~/layouts/PageLayout.astro";
import PageBanner from "~/components/widgets/PageBanner.astro";
import ContactForm from "~/components/widgets/contact/ContactForm.jsx";
import ContactImg from "~/assets/images/contact.png";
import { FaPhoneAlt, FaEnvelopeOpenText, FaFacebookF, FaLinkedinIn, FaTiktok } from "react-icons/fa";
import { FaLocationDot, FaXTwitter, FaArrowUpRightFromSquare } from "react-icons/fa6";

const metadata = {
  title: "Nous Contacter",
};

const contactCard = [
  {
    name: "Adresse",
    value: "Liberté 6 extension villa N°263, Dakar, Sénégal",
    icon: FaLocationDot,
  },
  {
    name: "Email",
    value: "aclsenegal@africtivistes.org",
    href: "mailto:aclsenegal@africtivistes.org",
    icon: FaEnvelopeOpenText,
  },
  {
    name: "Téléphone",
    value: "+221 78 018 01 05",
    href: "tel:+221780180105",
    icon: FaPhoneAlt,
  },
];

const socialLinks = [
  { name: "Facebook", link: "https://www.facebook.com/share/1AE5haRBVN/?mibextid=wwXIfr", icon: FaFacebookF },
  { name: "TikTok", link: "https://www.tiktok.com/@citizenlabsenegal?_r=1&_t=ZM-925WRddPKoO", icon: FaTiktok },
  { name: "LinkedIn", link: "https://www.linkedin.com/company/citizenlab-senegal/", icon: FaLinkedinIn },
  { name: "Twitter", link: "https://x.com/citizenlabsn?s=11", icon: FaXTwitter },
];
---

<Layout metadata={metadata}>
  <PageBanner
    image={ContactImg}
    alt="Contact CitizenLab Sénégal"
    label="Contact"
    title="Nous Contacter"
    description="Nous sommes là pour vous aider. N'hésitez pas à nous envoyer un message !"
  />

  <!-- Contenu principal -->
  <section class="py-16 bg-white/90 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Formulaire -->
        <div class="">
          <h2 class="text-lg font-bold text-gray-900 mb-1">Envoyez-nous un message</h2>
          <div class="w-12 h-[3px] bg-gradient-to-r from-green-600 to-green-400 rounded-full mb-6"></div>

          <ContactForm client:load />
        </div>

        <!-- Infos + Réseaux -->
        <div class="flex flex-col gap-5">
          <!-- Coordonnées -->
          <div class="">
            <h2 class="text-lg font-bold text-gray-900 mb-1">Nos coordonnées</h2>
            <div class="w-12 h-[3px] bg-gradient-to-r from-green-600 to-green-400 rounded-full mb-6"></div>

            <ul class="space-y-1">
              {contactCard.map((card) => {
                const Icon = card.icon;
                const Tag = card.href ? 'a' : 'div';
                return (
                  <li>
                    <Tag
                      href={card.href}
                      class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-green-50/50 transition-colors"
                    >
                      <span class="w-9 h-9 rounded-lg bg-green-50 border border-green-100 flex items-center justify-center text-green-700 shrink-0 mt-0.5">
                        <Icon className="w-4 h-4" />
                      </span>
                      <div>
                        <h3 class="text-sm font-semibold text-gray-900 mb-0.5">{card.name}</h3>
                        <p class="text-sm text-gray-500 leading-relaxed">{card.value}</p>
                      </div>
                    </Tag>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Réseaux sociaux -->
          <div class="relative overflow-hidden bg-gradient-to-br from-green-700 to-green-800 rounded-2xl p-6 md:p-8">
            <div class="absolute -top-8 -right-8 w-28 h-28 rounded-full bg-white/5"></div>
            <div class="absolute -bottom-6 -left-6 w-20 h-20 rounded-full bg-white/[0.03]"></div>

            <div class="relative z-10">
              <h3 class="text-sm font-bold text-white mb-4">Suivez-nous</h3>
              <div class="flex flex-wrap gap-2">
                {socialLinks.map((social) => {
                  const SocialIcon = social.icon;
                  return (
                    <a
                      href={social.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors"
                      aria-label={social.name}
                    >
                      <SocialIcon className="w-4 h-4" />
                    </a>
                  );
                })}
              </div>
              <p class="text-sm text-green-200 mt-4 leading-relaxed">
                Rejoignez notre communauté et restez informé de nos dernières actualités.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Localisation -->
     <div class="max-w-6xl mx-auto px-6 lg:px-8 mt-10">
      <div class="relative rounded-2xl overflow-hidden border border-gray-100">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3858.674431357392!2d-17.465673826142613!3d14.730989685770965!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xec10da6f3b7ebe7%3A0x817f4339dfb6752!2sAfricTivistes!5e0!3m2!1sfr!2ssn!4v1759775910205!5m2!1sfr!2ssn"
          width="100%"
          height="350"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full"
        ></iframe>
        <div class="absolute bottom-4 left-4">
          <a
            href="https://goo.gl/maps/ZQ6dfYkCMaK2"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 bg-white text-green-800 text-xs font-semibold rounded-lg shadow-md hover:bg-green-50 transition-colors"
          >
            Ouvrir dans Google Maps
            <FaArrowUpRightFromSquare className="w-3 h-3" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>