---
import Layout from "~/layouts/PageLayout.astro";
import PageBanner from "~/components/widgets/PageBanner.astro";
import { getAllMagazines } from "~/utils/api";
import { FaDownload, FaCalendarAlt } from "react-icons/fa";
import magazineBg from "~/assets/images/magazine.png";
import { HiArrowRight } from "react-icons/hi";

const magazines = await getAllMagazines();

const metadata = {
  title: "Magazines - AfricTivistes CitizenLab Sénégal", 
  ignoreTitleTemplate: true,
};

interface MagazinePost {
  slug: string;
  magazine: {
    titre: string;
    description: string;
    date: string;
    fichier: {
      node: {
        mediaItemUrl: string;
        altText: string;
      };
    } | null;
  };
  featuredImage: {
    node: {
      mediaItemUrl: string;
      altText: string;
    };
  } | null;
}

const featured: MagazinePost | null = magazines.length > 0 ? magazines[0] : null;
const otherMagazines: MagazinePost[] = magazines.slice(1);
---

<Layout metadata={metadata}>
  <PageBanner
    image={magazineBg}
    alt="Magazines CitizenLab"
    label="Publications"
    title="Nos Magazines"
    description="Explorez nos publications sur la participation citoyenne et l'innovation sociale au Sénégal."
  />

  <section class="py-16 bg-white/90 backdrop-blur-sm">

    <!-- Header -->
    <div class="flex flex-col items-center justify-center gap-4 mb-10">
      <div class="text-center">
        <h2 class="text-2xl text-center md:text-3xl lg:text-4xl font-bold text-gray-900">
          Nos dernières publications
        </h2>
      </div>
      
        <div class="mx-auto h-1 w-20 rounded-full bg-green-500"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">

      {magazines.length === 0 ? (
        <p class="text-center text-sm text-gray-400 py-10">
          Aucun magazine disponible pour le moment.
        </p>
      ) : (
        <>
          {/* Magazine en vedette */}
          {featured && (
            <div class="flex flex-col md:flex-row rounded-2xl border border-gray-100 hover:border-green-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 mb-8">
              <div class="md:w-[240px] lg:w-[280px] h-56 md:h-auto shrink-0 relative overflow-hidden bg-gray-100">
                {featured.featuredImage?.node?.mediaItemUrl ? (
                  <img
                    src={featured.featuredImage.node.mediaItemUrl}
                    alt={featured.featuredImage.node.altText ?? featured.magazine?.titre}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-green-800 to-green-700"></div>
                )}
              </div>

              <div class="flex-1 p-6 md:p-8 flex flex-col justify-center">
                <span class="inline-block text-[9px] font-semibold bg-green-600 text-white px-2.5 py-0.5 rounded-full uppercase tracking-wide mb-3 self-start">
                  Dernière édition
                </span>

                <a href={`/magazines/${featured.slug}`} class="text-lg md:text-xl font-bold text-gray-900 hover:text-green-600 transition-all duration-300 mb-2 leading-snug">
                  {featured.magazine?.titre}
                </a>

                {featured.magazine?.description && (
                  <p class="text-sm text-gray-500 leading-relaxed mb-3 line-clamp-3">
                    {featured.magazine.description}
                  </p>
                )}

                {featured.magazine?.date && (
                  <span class="inline-flex items-center gap-1.5 text-xs text-gray-400 mb-5">
                    <FaCalendarAlt className="w-3 h-3" />
                    {new Date(featured.magazine.date).toLocaleDateString("fr-FR", {
                      month: "long",
                      year: "numeric",
                    })}
                  </span>
                )}

                {featured.magazine?.fichier?.node?.mediaItemUrl && (
                  <a
                    href={`/magazines/${featured.slug}`}
                    class="inline-flex items-center gap-2 text-sm font-semibold text-green-600 hover:text-green-800 transition-colors group"
                  >
                    Découvrir ce numéro
                    <HiArrowRight className="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
                  </a>
                )}
              </div>
            </div>
          )}

          {/* Grille */}
          {otherMagazines.length > 0 && (
            <>
              <h3 class="text-sm font-semibold text-gray-900 mb-4">
                Toutes les éditions
              </h3>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="magazines-grid">
                {otherMagazines.map((mag: MagazinePost, index: number) => (
                  <div
                    class:list={[
                      "magazine-card bg-white rounded-2xl border border-gray-100 hover:border-green-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col",
                      { "hidden": index >= 6 }
                    ]}
                    data-index={index}
                  >
                    <div class="relative h-48 overflow-hidden bg-gray-100">
                      {mag.featuredImage?.node?.mediaItemUrl ? (
                        <img
                          src={mag.featuredImage.node.mediaItemUrl}
                          alt={mag.featuredImage.node.altText ?? mag.magazine?.titre}
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-full h-full bg-gradient-to-br from-green-800 to-green-700"></div>
                      )}
                    </div>

                    <div class="p-4 flex flex-col flex-1">
                      {mag.magazine?.date && (
                        <span class="text-[10px] text-gray-400 mb-2">
                          {new Date(mag.magazine.date).toLocaleDateString("fr-FR", {
                            month: "long",
                            year: "numeric",
                          })}
                        </span>
                      )}

                      <h3 class="text-sm font-semibold text-gray-900 mb-1 line-clamp-2">
                        {mag.magazine?.titre}
                      </h3>

                      {mag.magazine?.description && (
                        <p class="text-xs text-gray-500 leading-relaxed line-clamp-2 flex-1">
                          {mag.magazine.description}
                        </p>
                      )}
                    </div>
                    
                    <div class="flex items-center justify-between px-4 py-3 border-t border-gray-50">
                      {mag.magazine?.fichier?.node?.mediaItemUrl ? (
                        <a
                          href={mag.magazine.fichier.node.mediaItemUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          download
                          class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 hover:text-green-900 transition-colors"
                        >
                          <FaDownload className="w-3 h-3" />
                          Télécharger
                        </a>
                      ) : (
                        <span class="text-xs text-gray-300">Indisponible</span>
                      )}
                      <span class="text-[10px] text-gray-300">PDF</span>
                    </div>
                  </div>
                ))}
              </div>

              {otherMagazines.length > 6 && (
                <div class="mt-8 flex flex-col items-center gap-3">
                  <p class="text-xs text-gray-400">
                    <span id="magazines-shown">{Math.min(6, otherMagazines.length)}</span> sur {otherMagazines.length} éditions
                  </p>
                  <button
                    id="load-more-magazines"
                    class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold border border-green-600 text-green-600 hover:bg-green-600 hover:text-white rounded-lg transition-colors duration-300"
                  >
                    Voir plus de magazines
                  </button>
                </div>
              )}
            </>
          )}
        </>
      )}
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('load-more-magazines');
    const counter = document.getElementById('magazines-shown');
    const cards = document.querySelectorAll('.magazine-card');
    const step = 6;
    let visible = Math.min(step, cards.length);

    if (!btn) return;

    btn.addEventListener('click', () => {
      const next = Math.min(visible + step, cards.length);

      for (let i = visible; i < next; i++) {
        cards[i].classList.remove('hidden');
      }

      visible = next;
      if (counter) counter.textContent = String(visible);

      if (visible >= cards.length) {
        btn.style.display = 'none';
      }
    });
  });
</script>