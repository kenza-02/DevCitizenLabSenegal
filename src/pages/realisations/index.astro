---
import Layout from '~/layouts/PageLayout.astro';
import PageBanner from '~/components/widgets/PageBanner.astro';
import RealisationsImg from '~/assets/images/realisations.jpg';
import { getAllRealisations } from '~/utils/api';
import { FaArrowRight, FaArrowRightLong } from "react-icons/fa6";

interface Realisation {
  id: string;
  title: string;
  excerpt?: string;
  content?: string;
  date?: string;
  slug?: string;
  categories?: { nodes: { name: string; slug: string }[] };
  featuredImage?: { node: { mediaItemUrl: string; altText: string } };
  realisationsMeta?: { client?: string; technologies?: string[]; impact?: string };
}

const metadata = {
  title: 'Nos Réalisations | CitizenLab Sénégal',
  description: 'Découvrez nos projets réalisés en matière de participation citoyenne et d\'innovation sociale au Sénégal.',
};

const realisations: Realisation[] = await getAllRealisations();

function cleanExcerpt(excerpt: string): string {
  return excerpt.replace(/<[^>]*>/g, '').trim();
}

const projets = realisations.map((r, index) => {
  const id = r.slug || `realisation-${index}`;
  return {
    id,
    title: r.title,
    category: r.categories?.nodes?.[0]?.name || 'Réalisation',
    date: r.date ? new Date(r.date).toLocaleDateString('fr-FR', {
      day: "numeric", year: 'numeric', month: 'long'
    }) : 'Date non spécifiée',
    image: r.featuredImage?.node?.mediaItemUrl || '/assets/images/default.png',
    description: r.excerpt
      ? cleanExcerpt(r.excerpt)
      : (r.content ? cleanExcerpt(r.content.substring(0, 150) + '...') : 'Découvrez ce projet innovant de CitizenLab Sénégal'),
  };
});

---

<Layout metadata={metadata}>
  <!-- Banner -->
  <PageBanner
    image={RealisationsImg}
    alt="Nos Réalisations"
    label="Réalisations"
    title="Nos Réalisations"
    description="Découvrez les projets qui transforment la participation citoyenne au Sénégal. Chaque réalisation reflète notre engagement pour l'innovation sociale."
  />

  <!-- Grille des réalisations -->
  <section id="projets" class="bg-white/80 backdrop-blur-sm py-16 px-6 lg:px-8 mx-auto max-w-7xl">
    <div class="mb-10 flex flex-col items-center gap-4">
      <h2 class="text-2xl md:text-3xl text-center font-bold text-gray-900">
        Projets realisés
      </h2>
      <p class="text-mutad-foreground text-gray-500 text-center max-w-xl mx-auto">
        Une sélection de nos réalisations les plus impactantes
      </p>

      <div class="h-[3px] w-20 bg-gradient-to-r from-green-600 to-green-400 rounded-full"></div>
    </div>

    {projets.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-sm text-gray-400 mb-1">Aucune réalisation disponible pour le moment.</p>
        <p class="text-xs text-gray-300">Nos projets seront bientôt publiés.</p>
      </div>
    ) : (
      <>
        <div class="grid gap-5 grid-cols-1 md:grid-cols-2 lg:grid-cols-3" id="realisations-grid">
          {projets.map((projet, index) => (
            <a
              href={`/realisations/${projet.id}`}
              class:list={[
                "realisation-card block h-full",
                { "hidden": index >= 6 }
              ]}
              data-index={index}
            >
              <article class="group bg-white dark:bg-slate-900 rounded-2xl overflow-hidden border border-gray-100 hover:border-green-200 shadow-sm hover:shadow-lg transition-all duration-300 h-full flex flex-col">
                <div class="relative h-44 overflow-hidden">
                  <img
                    src={projet.image}
                    alt={projet.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    onerror="this.src='/assets/images/default.png'"
                  />
                  <span class="absolute top-3 left-3 bg-green-600 text-white text-[10px] font-semibold uppercase tracking-wide px-3 py-1 rounded-full">
                    {projet.category}
                  </span>
                </div>

                <div class="p-5 flex flex-col flex-1">
                  <span class="text-xs text-gray-400 mb-2">{projet.date}</span>

                  <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2 line-clamp-3 group-hover:text-green-800 transition-colors">
                    {projet.title}
                  </h3>

                  <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed line-clamp-3 flex-1">
                    {projet.description}
                  </p>

                  <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-50">
                    <span class="text-xs font-medium text-green-700">Voir le projet</span>
                    <span class="inline-flex items-center justify-center w-7 h-7 bg-green-50 group-hover:bg-green-600 rounded-full transition-all duration-300">
                      <FaArrowRight className="w-3 h-3 text-green-600 group-hover:text-white transition-colors" />
                    </span>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>

        <!-- Compteur + voir plus -->
        <div class="py-8 flex flex-col items-center gap-3">
          <p class="text-xs text-gray-400">
            <span id="realisations-shown">{Math.min(6, projets.length)}</span> sur {projets.length} réalisations
          </p>
          {projets.length > 6 && (
            <button
              id="load-more-realisations"
              class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold border border-green-600 text-green-600 hover:bg-green-600 hover:text-white rounded-lg transition-colors duration-300"
            >
              Voir plus de réalisations
            </button>
          )}
        </div>
      </>
    )}

    <!-- CTA -->
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-green-700 to-green-800">
        <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/5"></div>
        <div class="absolute -bottom-8 -left-8 w-28 h-28 rounded-full bg-white/[0.03]"></div>

        <div class="relative z-10 px-6 md:px-12 py-12 md:py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div class="max-w-xl">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">
              Découvrez nos projets en cours
            </h2>
            <p class="text-mutad-foreground text-green-200 leading-relaxed">
              Projets actuellement en développement pour une transformation continue.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a
              href="/projets"
              class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-white text-green-800 text-sm font-semibold rounded-lg hover:bg-green-50 transition-colors"
            >
              Voir nos projets
              <FaArrowRightLong className="w-3.5 h-3.5" />
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 px-6 py-2.5 border border-white/30 text-white text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors"
            >
              Nous contacter
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('load-more-realisations');
    const counter = document.getElementById('realisations-shown');
    const cards = document.querySelectorAll('.realisation-card');
    const step = 6;
    let visible = Math.min(step, cards.length);

    if (!btn) return;

    btn.addEventListener('click', () => {
      const next = Math.min(visible + step, cards.length);

      for (let i = visible; i < next; i++) {
        cards[i].classList.remove('hidden');
      }

      visible = next;
      if (counter) counter.textContent = String(visible);

      if (visible >= cards.length) {
        btn.style.display = 'none';
      }
    });
  });
</script>