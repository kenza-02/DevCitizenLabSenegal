---
import Layout from "~/layouts/PageLayout.astro";
import { getAllVideos, extractVideoUrl } from "~/utils/api";
import { FaArrowLeft, FaFacebookF, FaLinkedinIn, FaWhatsapp, FaLink } from "react-icons/fa";
import { FaXTwitter } from "react-icons/fa6";

export async function getStaticPaths() {
  const videos = await getAllVideos();

  return videos.map((post: any) => ({
    params: { slug: post.slug },
    props: { video: post },
  }));
}

const { video } = Astro.props as { video: any };

if (!video) {
  throw new Error("Vidéo introuvable");
}

const videoHtml = extractVideoUrl(video.content);

const metadata = {
  title: `${video.title} — Vidéos`,
};

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const pageUrl = `${siteUrl}/videos/${video.slug}`;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(video.title);

const shareLinks = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  twitter: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  whatsapp: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
};
---

<Layout metadata={metadata}>
  <main class="py-12 bg-[#fcfcfc]/90 backdrop-blur-sm">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">

      <!-- Retour -->
      <a
        href="/videos"
        class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-green-800 transition-colors mb-8"
      >
        <FaArrowLeft className="w-3 h-3" />
        Retour aux vidéos
      </a>

      <!-- Header -->
      <div class="mb-6">
        <span class="inline-block text-xs font-semibold text-green-800 border border-green-200 bg-green-50 px-3 py-1 rounded-full mb-4">
          Vidéo
        </span>

        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 leading-tight">
          {video.title}
        </h1>

        <div class="flex flex-wrap items-center gap-3">
          <span class="text-xs text-gray-400">
            {new Date(video.date).toLocaleDateString("fr-FR", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </span>

          <span class="text-gray-200 hidden sm:inline">|</span>

          <div class="flex items-center gap-1.5">
            <span class="text-xs text-gray-400 mr-0.5">Partager</span>
            <a href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="Facebook">
              <FaFacebookF className="w-3 h-3" />
            </a>
            <a href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="X">
              <FaXTwitter className="w-3 h-3" />
            </a>
            <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="LinkedIn">
              <FaLinkedinIn className="w-3 h-3" />
            </a>
            <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="WhatsApp">
              <FaWhatsapp className="w-3.5 h-3.5" />
            </a>
            <button id="copy-link-top" class="share-icon-btn" aria-label="Copier le lien">
              <FaLink className="w-3 h-3" />
            </button>
          </div>
        </div>
      </div>

      <!-- Lecteur vidéo -->
      {videoHtml ? (
        <div class="rounded-2xl overflow-hidden border border-gray-200 mb-8 bg-black">
          <div class="video-player" set:html={videoHtml} />
        </div>
      ) : video.content ? (
        <!-- Fallback  -->
        <div class="rounded-2xl overflow-hidden border border-gray-200 mb-8 bg-black">
          <div class="video-player" set:html={video.content} />
        </div>
      ) : video.featuredImage?.node?.mediaItemUrl ? (
        <div class="rounded-2xl overflow-hidden mb-8">
          <img
            src={video.featuredImage.node.mediaItemUrl}
            alt={video.featuredImage.node.altText ?? video.title}
            class="w-full h-auto"
          />
        </div>
      ) : null}

      <!-- Description -->
      {video.excerpt && (
        <div class="mb-8">
          <h2 class="text-lg font-bold text-gray-900 mb-3">À propos de cette vidéo</h2>
          <div
            class="text-sm text-gray-600 leading-relaxed"
            set:html={video.excerpt}
          />
        </div>
      )}

      <!-- Partage bas -->
      <div class="border-t border-gray-100 mt-10 pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <span class="text-sm font-semibold text-gray-900">Partager cette vidéo</span>

        <div class="flex flex-wrap items-center gap-2">
          <a href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" class="share-pill-btn">
            <FaFacebookF className="w-3 h-3" />
            Facebook
          </a>
          <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="share-pill-btn">
            <FaWhatsapp className="w-3.5 h-3.5" />
            WhatsApp
          </a>
          <a href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" class="share-pill-btn">
            <FaXTwitter className="w-3 h-3" />
            Twitter
          </a>
          <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" class="share-pill-btn">
            <FaLinkedinIn className="w-3 h-3" />
            LinkedIn
          </a>
          <button id="copy-link-bottom" class="share-pill-btn">
            <FaLink className="w-3 h-3" />
            <span class="copy-label">Copier</span>
          </button>
        </div>
      </div>

    </div>
  </main>
</Layout>

<style>
  .video-player :global(video) {
    width: 100%;
    height: auto;
    display: block;
  }
  .video-player :global(figure) {
    margin: 0;
  }
  .video-player :global(figure video) {
    width: 100%;
    height: auto;
    display: block;
  }
  .video-player :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    border: none;
  }
  .video-player :global(.wp-block-embed),
  .video-player :global(.wp-block-embed__wrapper) {
    margin: 0;
  }
  .video-player :global(p) {
    display: none;
  }

  .share-icon-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #e5e7eb;
    background: white;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.15s;
  }
  .share-icon-btn:hover {
    background: #f0fdf4;
    border-color: #86efac;
    color: #166534;
  }

  .share-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid #e5e7eb;
    font-size: 12px;
    font-weight: 500;
    color: #6b7280;
    background: white;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
  }
  .share-pill-btn:hover {
    background: #f0fdf4;
    border-color: #86efac;
    color: #166534;
  }
</style>

<script define:vars={{ pageUrl }}>
  function copyToClipboard(buttonId) {
    const btn = document.getElementById(buttonId);
    if (!btn) return;

    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(pageUrl).then(() => {
        const label = btn.querySelector('.copy-label');
        if (label) {
          label.textContent = 'Copié !';
          setTimeout(() => { label.textContent = 'Copier'; }, 2000);
        } else {
          btn.style.borderColor = '#16a34a';
          btn.style.color = '#166534';
          setTimeout(() => {
            btn.style.borderColor = '';
            btn.style.color = '';
          }, 2000);
        }
      });
    });
  }

  copyToClipboard('copy-link-top');
  copyToClipboard('copy-link-bottom');
</script>