---
import { getAllFormations } from "~/utils/api.js";
import Layout from "~/layouts/PageLayout.astro";
import PageBanner from "~/components/widgets/PageBanner.astro";
import bootcamp_hero from '~/assets/images/formations.png';
import { FaCalendarAlt, FaMapMarkerAlt, FaArrowRight } from "react-icons/fa";

const wpFormations = await getAllFormations();

const metadata = {
  title: "Formations",
};

const formations = wpFormations.map((post: any) => ({
  slug: post.slug,
  image: post.featuredImage?.node?.mediaItemUrl ?? null,
  nom: post.formation?.nom ?? "",
  description: post.formation?.description ?? "",
  lieu: post.formation?.lieu ?? "",
  date: post.formation?.date
    ? new Date(post.formation.date).toLocaleDateString("fr-FR", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : "",
  formateur: post.formation?.formateur ?? "",
  lien: post.formation?.lien?.url ?? null,
  prix: post.formation?.prix ?? "",
  status: Array.isArray(post.formation?.statut)
    ? post.formation.statut[0]
    : post.formation?.statut ?? "",
}));

function getStatusClasses(status: string) {
  switch(status) {
    case "Inscriptions ouvertes":
      return "bg-green-50 text-green-700 border-green-200";
    case "Complet":
      return "bg-orange-50 text-orange-700 border-orange-200";
    case "Terminée":
      return "bg-red-50 text-red-700 border-red-200";
    default:
      return "bg-gray-50 text-gray-600 border-gray-200";
  }
}
---

<Layout metadata={metadata}>
  <PageBanner
    image={bootcamp_hero}
    alt="Formations CitizenLab"
    label="Formations"
    title="Nos Formations"
    description="Programmes de formation professionnelle pour renforcer vos capacités en civic tech."
  />

  <section class="py-16 bg-white/80 backdrop-blur-sm">

    <!-- Header -->
    <div class="flex flex-col items-center justify-center gap-4 mb-10">
      <div class="text-center">
        <h2 class="text-2xl text-center md:text-3xl lg:text-4xl font-bold text-gray-900">
          Nos dernières formations
        </h2>
      </div>
      
        <div class="mx-auto h-1 w-20 rounded-full bg-green-500"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">

      {formations.length === 0 ? (
        <p class="text-center text-sm text-gray-400 py-10">
          Aucune formation disponible pour le moment.
        </p>
      ) : (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="formations-grid">
            {formations.map((formation: any, index: number) => (
              <article
                class:list={[
                  "formation-card bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-green-200 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col",
                  { "hidden": index >= 6 }
                ]}
                data-index={index}
              >
                <!-- Image -->
                <div class="relative h-44 overflow-hidden">
                  {formation.image && (
                    <img
                      src={formation.image}
                      alt={formation.nom}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>

                  {formation.status && (
                    <span class={`absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-xs font-semibold border ${getStatusClasses(formation.status)}`}>
                      {formation.status}
                    </span>
                  )}

                  {formation.prix && (
                    <span class="absolute bottom-3 left-3 px-3 py-1 bg-green-700/90 backdrop-blur-sm rounded-full text-white text-xs font-semibold">
                      {formation.prix}
                    </span>
                  )}
                </div>

                <!-- Contenu -->
                <div class="p-5 flex flex-col flex-1">
                  <h3 class="text-sm font-bold text-gray-900 mb-2 line-clamp-2">
                    {formation.nom}
                  </h3>

                  <p class="text-sm text-gray-500 leading-relaxed line-clamp-2 mb-4 flex-1">
                    {formation.description}
                  </p>

                  <!-- Infos -->
                  <div class="flex flex-wrap gap-3 text-xs text-gray-500 mb-4">
                    {formation.date && (
                      <span class="inline-flex items-center gap-1.5">
                        <FaCalendarAlt className="w-3 h-3 text-green-600" />
                        {formation.date}
                      </span>
                    )}
                    {formation.lieu && (
                      <span class="inline-flex items-center gap-1.5">
                        <FaMapMarkerAlt className="w-3 h-3 text-green-600" />
                        {formation.lieu}
                      </span>
                    )}
                  </div>

                  <!-- Actions -->
                  <div class="flex gap-2 pt-4 border-t border-gray-50">
                    {formation.status === "Inscriptions ouvertes" && formation.lien && (
                      <a
                        href={formation.lien}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-xs font-semibold rounded-lg transition-colors"
                      >
                        S'inscrire
                        <FaArrowRight className="w-3 h-3" />
                      </a>
                    )}
                    <a
                      href={`/formations/${formation.slug}`}
                      class:list={[
                        "inline-flex items-center justify-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-lg transition-colors",
                        { "flex-1": formation.status !== "Inscriptions ouvertes" || !formation.lien }
                      ]}
                    >
                      Détails
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- Voir plus -->
          {formations.length > 6 && (
            <div class="mt-8 flex flex-col items-center gap-3">
              <p class="text-xs text-gray-400">
                <span id="formations-shown">{Math.min(6, formations.length)}</span> sur {formations.length} formations
              </p>
              <button
                id="load-more-formations"
                class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold border border-green-600 text-green-600 hover:bg-green-600 hover:text-white rounded-lg transition-colors duration-300"
              >
                Voir plus de formations
              </button>
            </div>
          )}
        </>
      )}
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('load-more-formations');
    const counter = document.getElementById('formations-shown');
    const cards = document.querySelectorAll('.formation-card');
    const step = 6;
    let visible = Math.min(step, cards.length);

    if (!btn) return;

    btn.addEventListener('click', () => {
      const next = Math.min(visible + step, cards.length);

      for (let i = visible; i < next; i++) {
        cards[i].classList.remove('hidden');
      }

      visible = next;
      if (counter) counter.textContent = String(visible);

      if (visible >= cards.length) {
        btn.style.display = 'none';
      }
    });
  });
</script>