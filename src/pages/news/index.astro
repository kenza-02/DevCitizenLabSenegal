---
import Layout from "~/layouts/PageLayout.astro";
import PageBanner from "~/components/widgets/PageBanner.astro";
import { getAllActualites } from "~/utils/api";
import actualiteImg from "~/assets/images/actualite.jpg";
import { FaArrowRight } from "react-icons/fa";

const wpArticles = await getAllActualites();

const metadata = {
  title: "Actualités et medias - AfricTivistes CitizenLab Sénégal",
  ignoreTitleTemplate: true,
};

const articles = wpArticles.map((post: any) => {
  const cleanDescription =
    post.excerpt
      ?.replace(/<[^>]*>/g, "")
      ?.replace(/&nbsp;/g, " ")
      ?.replace(/&#8230;/g, "...")
      ?.trim()
      ?.slice(0, 150) + "..." || "";

  return {
    slug: post.slug,
    data: {
      title: post.title,
      description: cleanDescription,
      date: new Date(post.date).toLocaleDateString("fr-FR", {
        year: "numeric",
        month: "long",
        day: "numeric",
      }),
      category: post.categories?.nodes?.[0]?.name ?? "Actualité",
      image: post.featuredImage?.node?.mediaItemUrl,
    },
  };
});


---

<Layout metadata={metadata}>
  <PageBanner
    image={actualiteImg}
    alt="Actualités"
    label="Blog"
    title="Actualités"
    description="Retrouvez ici l'ensemble de nos actualités, événements et publications."
  />

  <section class="bg-white/80 backdrop-blur-sm py-16 px-6 md:px-10" id="news-section">
    
    <!-- Header -->
    <div class="flex flex-col items-center justify-center gap-4 mb-10">
      <div class="text-center">
        <h2 class="text-2xl text-center md:text-3xl lg:text-4xl font-bold text-gray-900">
          Les dernières actualités
        </h2>
      </div>
      
        <div class="mx-auto h-1 w-20 rounded-full bg-green-500"></div>
    </div>

    {articles.length === 0 ? (
      <p class="text-center text-sm text-gray-400 py-10">
        Aucune actualité disponible pour le moment.
      </p>
    ) : (
      <>
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
          id="cards-grid"
        >
          {articles.map((article: any, index: number) => (
            <a
              href={`/news/${article.slug}`}
              class:list={[
                "actu-card block h-full",
                { "hidden": index >= 6 }
              ]}
              data-index={index}
            >
              <article class="group bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-green-300 shadow-sm hover:shadow-lg transition-all duration-300 h-full flex flex-col">
                <div class="relative h-48 overflow-hidden">
                  <img
                    src={article.data.image}
                    alt={article.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-xs font-semibold text-green-800 uppercase tracking-wider px-3 py-1 rounded-full">
                    {article.data.category}
                  </span>
                </div>

                <div class="p-5 flex flex-col flex-1">
                  <span class="text-xs text-gray-400 mb-2">
                    {article.data.date}
                  </span>

                  <h3 class="text-base font-semibold text-gray-900 mb-2 line-clamp-2 group-hover:text-green-800 transition-colors">
                    {article.data.title}
                  </h3>

                  <p class="text-sm text-gray-500 leading-relaxed line-clamp-3 flex-1">
                    {article.data.description}
                  </p>

                  <div class="flex justify-end mt-4 pt-4 border-t border-gray-50">
                    <span class="inline-flex items-center justify-center w-8 h-8 bg-green-50 group-hover:bg-green-600 rounded-full transition-all duration-300">
                      <FaArrowRight className="w-3 h-3 text-green-600 group-hover:text-white transition-colors" />
                    </span>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>

        <!-- Compteur + voir plus -->
        <div class="mt-8 flex flex-col items-center gap-3">
          <p class="text-xs text-gray-500">
            <span id="actus-shown">{Math.min(6, articles.length)}</span> sur {articles.length} actualités
          </p>
          {articles.length > 6 && (
            <button
              id="load-more-actus"
              class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold border border-green-600 text-green-600 hover:bg-green-600 hover:text-white rounded-lg transition-colors duration-300"
            >
              Voir plus d'actualités
            </button>
          )}
        </div>
      </>
    )}
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('load-more-actus');
    const counter = document.getElementById('actus-shown');
    const cards = document.querySelectorAll('.actu-card');
    const step = 6;
    let visible = Math.min(step, cards.length);

    if (!btn) return;

    btn.addEventListener('click', () => {
      const next = Math.min(visible + step, cards.length);

      for (let i = visible; i < next; i++) {
        cards[i].classList.remove('hidden');
      }

      visible = next;
      if (counter) counter.textContent = String(visible);

      if (visible >= cards.length) {
        btn.style.display = 'none';
      }
    });
  });
</script>