---
import Layout from "~/layouts/PageLayout.astro";
import PageBanner from "~/components/widgets/PageBanner.astro";
import podcast_bg from "~/assets/images/podcast.png";
import { FaPlay } from "react-icons/fa";
import type { Podcast } from "~/types/podcasts";
import { getPodcastPosts, extractAudioUrl } from "~/utils/api";

const metadata = {
  title: "Podcast - CitizenLab Sénégal",
  description:
    "Découvrez nos podcasts inspirants sur l'engagement citoyen et le changement social",
};

const posts = await getPodcastPosts();

const podcasts: Podcast[] = posts.map((post: any) => ({
  id: post.id,
  slug: post.slug,
  title: post.title,
  episode: post.categories?.nodes?.[0]?.name ?? "Épisode",
  date: new Date(post.date).toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }),
  category: post.categories?.nodes?.[0]?.name ?? "Podcast",
  description: post.excerpt?.replace(/<[^>]+>/g, "").trim(),
  audioHtml: extractAudioUrl(post.content) ?? "",
  coverImage: post.featuredImage?.node?.mediaItemUrl ?? "",
}));

const featured = podcasts.length > 0 ? podcasts[0] : null;
const otherEpisodes = podcasts.slice(1);
---

<Layout metadata={metadata}>
  <PageBanner
    image={podcast_bg}
    alt="Podcasts CitizenLab"
    label="Podcasts"
    title="Nos Podcasts"
    description="Découvrez nos contenus audio sur l'engagement citoyen et le changement social."
  />

  <section class="py-16 bg-white/80 backdrop-blur-sm">

    <!-- Header -->
    <div class="flex flex-col items-center justify-center gap-4 mb-10">
      <div class="text-center">
        <h2 class="text-2xl text-center md:text-3xl lg:text-4xl font-bold text-gray-900">
          Nos derniers podcasts
        </h2>
      </div>
      
        <div class="mx-auto h-1 w-20 rounded-full bg-green-500"></div>
    </div>

    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      {
        podcasts.length === 0 ? (
          <p class="text-center text-sm text-gray-400 py-10">
            Aucun podcast disponible pour le moment.
          </p>
        ) : (
          <>
            {/* Dernier épisode en vedette */}
            {featured && (
              <div class="relative rounded-2xl overflow-hidden min-h-[280px] md:min-h-[320px] flex flex-col justify-end mb-10">
                {featured.coverImage ? (
                  <img
                    src={featured.coverImage}
                    alt={featured.title}
                    class="absolute inset-0 w-full h-full object-cover"
                  />
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-br from-green-900 to-green-800" />
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10" />

                <div class="relative z-10 p-6 md:p-8 text-white">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-[9px] font-semibold bg-green-600 text-white px-2.5 py-0.5 rounded-full uppercase tracking-wide">
                      Nouveau
                    </span>
                    <span class="text-[11px] text-white/50">
                      {featured.episode} • {featured.date}
                    </span>
                  </div>

                  <h2 class="text-lg md:text-xl font-bold mb-2 leading-snug">
                    {featured.title}
                  </h2>

                  {featured.description && (
                    <p class="text-sm text-white/60 leading-relaxed mb-4 line-clamp-2 max-w-2xl">
                      {featured.description}
                    </p>
                  )}

                  {/* Player audio */}
                  <a
                    href={`/podcasts/${featured.slug}`}
                    class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors"
                  >
                    <FaPlay className="w-3 h-3" />
                    Écouter
                  </a>
                </div>
              </div>
            )}

            {/* Liste des autres épisodes */}
            {otherEpisodes.length > 0 && (
              <>
                <h3 class="text-mutad-foreground font-semibold text-gray-900 mb-4">
                  Tous les épisodes
                </h3>

                <div class="flex flex-col gap-2" id="episodes-list">
                  {otherEpisodes.map((podcast, index) => (
                    <div
                      onclick={`location.href='/podcasts/${podcast.slug}'`}
                      class:list={[
                        "episode-item cursor-pointer group flex items-center gap-4 p-4 md:p-5 rounded-xl border border-gray-100 hover:border-green-200 bg-white transition-all duration-200",
                        { hidden: index >= 8 },
                      ]}
                      data-index={index}
                    >
                      {/* Thumbnail */}
                      <div class="w-16 h-16 sm:w-18 sm:h-18 md:w-20 md:h-20 rounded-lg overflow-hidden flex-shrink-0 relative">
                        {podcast.coverImage ? (
                          <img
                            src={podcast.coverImage}
                            alt={podcast.title}
                            class="w-full h-full object-cover"
                            loading="lazy"
                          />
                        ) : (
                          <div class="w-full h-full bg-gradient-to-br from-green-800 to-green-700" />
                        )}
                        <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                          <FaPlay className="w-3 h-3 text-white" />
                        </div>
                      </div>

                      {/* Info */}
                      <div class="flex-1 min-w-0">
                        <p
                          class="text-sm sm:text-base font-semibold text-gray-900 truncate group-hover:text-green-800 transition-colors"
                        >
                          {podcast.title}
                        </p>
                        <div class="flex items-center gap-3 mt-2 flex-wrap">
                          <span class="text-xs sm:text-sm font-medium text-green-700 bg-green-50 px-3 py-1 rounded-full">
                            {podcast.episode}
                          </span>
                          <span class="text-xs text-gray-400">
                            {podcast.date}
                          </span>
                        </div>
                      </div>

                      {/* Play button */}
                      <div
                        class="w-8 h-8 rounded-full border border-gray-200 group-hover:bg-green-600 group-hover:border-green-600 flex items-center justify-center transition-all duration-200 shrink-0"
                      >
                        <FaPlay className="w-2.5 h-2.5 text-green-600 group-hover:text-white transition-colors" />
                      </div>
                    </div>
                  ))}
                </div>

                {/* Voir plus */}
                {otherEpisodes.length > 8 && (
                  <div class="mt-6 flex flex-col items-center gap-2">
                    <p class="text-xs text-gray-400">
                      <span id="episodes-shown">
                        {Math.min(8, otherEpisodes.length)}
                      </span>{" "}
                      sur {otherEpisodes.length} épisodes
                    </p>
                    <button
                      id="load-more-episodes"
                      class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold border border-green-600 text-green-600 hover:bg-green-600 hover:text-white rounded-lg transition-colors duration-300"
                    >
                      Voir plus d'épisodes
                    </button>
                  </div>
                )}
              </>
            )}
          </>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .podcast-audio audio {
    width: 100%;
    height: 36px;
    border-radius: 8px;
  }

  .podcast-audio audio::-webkit-media-controls-panel {
    background: transparent;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("load-more-episodes");
    const counter = document.getElementById("episodes-shown");
    const items = document.querySelectorAll(".episode-item");
    const step = 8;
    let visible = Math.min(step, items.length);

    if (!btn) return;

    btn.addEventListener("click", () => {
      const next = Math.min(visible + step, items.length);

      for (let i = visible; i < next; i++) {
        items[i].classList.remove("hidden");
      }

      visible = next;
      if (counter) counter.textContent = String(visible);

      if (visible >= items.length) {
        btn.style.display = "none";
      }
    });
  });
</script>
