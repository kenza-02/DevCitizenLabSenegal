---
import Layout from "~/layouts/PageLayout.astro";
import type { Podcast } from "~/types/podcasts";
import { getPodcastPosts, extractAudioUrl } from "~/utils/api";
import { FaArrowLeft, FaFacebookF, FaLinkedinIn, FaWhatsapp, FaLink, FaPlay } from "react-icons/fa";
import { FaXTwitter } from "react-icons/fa6";

export async function getStaticPaths() {
  const posts = await getPodcastPosts();

  return posts.map((post : any) => ({
    params: { slug: String(post.slug) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: any };

const podcast: Podcast = {
  id: post.id,
  slug: post.slug,
  title: post.title,
  episode: post.categories?.nodes?.[0]?.name ?? "Podcast",
  category: post.categories?.nodes?.[0]?.name ?? "Podcast",
  date: new Date(post.date).toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }),
  description: post.excerpt?.replace(/<[^>]+>/g, "").trim() ?? "",
  content: post.content ?? "",
  audioHtml: extractAudioUrl(post.content) ?? "",
  coverImage: post.featuredImage?.node?.mediaItemUrl,
};

const metadata = {
  title: `${podcast.title} – Podcast`,
  description: podcast.description,
};

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const podcastUrl = `${siteUrl}/podcasts/${podcast.slug}`;
const encodedUrl = encodeURIComponent(podcastUrl);
const encodedTitle = encodeURIComponent(podcast.title);

const shareLinks = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  twitter: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  whatsapp: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
};
---

<Layout metadata={metadata}>
  <main class="py-12 bg-[#fcfcfc]/90 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">

      <!-- Retour -->
      <a
        href="/podcasts"
        class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-green-800 transition-colors mb-8"
      >
        <FaArrowLeft className="w-3 h-3" />
        Retour aux podcasts
      </a>

      <!-- Header : image + infos -->
      <div class="flex flex-col md:flex-row gap-6 md:gap-8 mb-8">
        <!-- Cover -->
        {podcast.coverImage && (
          <div class="w-full md:w-64 lg:w-72 shrink-0">
            <div class="relative rounded-2xl overflow-hidden aspect-square">
              <img
                src={podcast.coverImage}
                alt={podcast.title}
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-black/10"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-14 h-14 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center shadow-lg">
                  <FaPlay className="w-5 h-5 text-green-700 ml-0.5" />
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- Infos -->
        <div class="flex-1 flex flex-col justify-center">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[10px] font-semibold text-green-800 bg-green-50 border border-green-100 px-2.5 py-0.5 rounded-full uppercase tracking-wide">
              {podcast.episode}
            </span>
            <span class="text-xs text-gray-400">{podcast.date}</span>
          </div>

          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3 leading-tight">
            {podcast.title}
          </h1>

          {podcast.description && (
            <p class="text-sm text-gray-500 leading-relaxed mb-4 max-w-2xl">
              {podcast.description}
            </p>
          )}

          <!-- Partage rapide -->
          <div class="flex items-center gap-1.5">
            <a href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="Facebook">
              <FaFacebookF className="w-3 h-3" />
            </a>
            <a href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="X">
              <FaXTwitter className="w-3 h-3" />
            </a>
            <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="LinkedIn">
              <FaLinkedinIn className="w-3 h-3" />
            </a>
            <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="WhatsApp">
              <FaWhatsapp className="w-3.5 h-3.5" />
            </a>
            <button id="copy-link-top" class="share-icon-btn" aria-label="Copier le lien">
              <FaLink className="w-3 h-3" />
            </button>
          </div>
        </div>
      </div>

      <!-- Player audio -->
      {podcast.audioHtml && (
        <div class="bg-green-50 border border-green-100 rounded-2xl p-5 mb-8">
          <p class="text-xs font-medium text-green-800 mb-3">Écouter l'épisode</p>
          <div class="podcast-audio" set:html={podcast.audioHtml} />
        </div>
      )}



      <!-- Partage bas -->
      <div class="border-t border-gray-100 mt-10 pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <span class="text-sm font-semibold text-gray-900">Partager cet épisode</span>

        <div class="flex flex-wrap items-center gap-2">
          <a href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" class="share-pill-btn">
            <FaFacebookF className="w-3 h-3" />
            Facebook
          </a>
          <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="share-pill-btn">
            <FaWhatsapp className="w-3.5 h-3.5" />
            WhatsApp
          </a>
          <a href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" class="share-pill-btn">
            <FaXTwitter className="w-3 h-3" />
            Twitter
          </a>
          <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" class="share-pill-btn">
            <FaLinkedinIn className="w-3 h-3" />
            LinkedIn
          </a>
          <button id="copy-link-bottom" class="share-pill-btn">
            <FaLink className="w-3 h-3" />
            <span class="copy-label">Copier</span>
          </button>
        </div>
      </div>

    </div>
  </main>
</Layout>

<style>
  .share-icon-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #e5e7eb;
    background: white;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.15s;
  }
  .share-icon-btn:hover {
    background: #f0fdf4;
    border-color: #86efac;
    color: #166534;
  }

  .share-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid #e5e7eb;
    font-size: 12px;
    font-weight: 500;
    color: #6b7280;
    background: white;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
  }
  .share-pill-btn:hover {
    background: #f0fdf4;
    border-color: #86efac;
    color: #166534;
  }

  .podcast-audio :global(audio) {
    width: 100%;
    height: 40px;
    border-radius: 10px;
  }
</style>

<script define:vars={{ podcastUrl }}>
  function copyToClipboard(buttonId) {
    const btn = document.getElementById(buttonId);
    if (!btn) return;

    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(podcastUrl).then(() => {
        const label = btn.querySelector('.copy-label');
        if (label) {
          label.textContent = 'Copié !';
          setTimeout(() => { label.textContent = 'Copier'; }, 2000);
        } else {
          btn.style.borderColor = '#16a34a';
          btn.style.color = '#166534';
          setTimeout(() => {
            btn.style.borderColor = '';
            btn.style.color = '';
          }, 2000);
        }
      });
    });
  }

  copyToClipboard('copy-link-top');
  copyToClipboard('copy-link-bottom');
</script>