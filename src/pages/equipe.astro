---
import Layout from "~/layouts/PageLayout.astro";
import PageBanner from "~/components/widgets/PageBanner.astro";
import { getAllMembers } from "~/utils/api";
import Membres from "~/components/blog/Membres.astro";
import teamBanner from "~/assets/images/Equipe.jpeg";

const metadata = {
  title: "Équipe - AfricTivistes CitizenLab Sénégal",
  description:
    "Découvrez les membres et l'univers de l'équipe CitizenLab Sénégal : des talents engagés pour renforcer la participation citoyenne.",
  ignoreTitleTemplate: true,
  };

const members = await getAllMembers();
---

<Layout metadata={metadata}>
  <!-- Hero Banner -->
  <PageBanner
    image={teamBanner}
    alt="Équipe CitizenLab Sénégal"
    label="Notre équipe"
    title="Une équipe engagée au service de la participation citoyenne"
    description="CitizenLab Sénégal fédère une communauté de talents complémentaires — stratèges, créateurs de contenu, formateurs et activistes — réunis pour renforcer la démocratie participative."
  />

  <section class="bg-white/90 backdrop-blur-sm space-y-6 py-16">
    <!-- Notre ADN -->
    <div>
      <div class="mx-auto px-6 lg:px-8">
        <span
          class="inline-flex items-center gap-1.5 text-xs md:text-sm font-medium text-green-700 uppercase tracking-widest mb-2"
        >
          Notre ADN
        </span>
        <h2 class="text-xl md:text-3xl font-bold text-gray-900 mb-3">
          L'humain au centre, l'impact comme horizon
        </h2>
        <p
          class="text-muted-foreground text-gray-500 leading-7 max-w-3xl"
        >
          Notre équipe se construit autour de valeurs fortes : rigueur
          citoyenne, inclusion, innovation et partage. Nous cultivons un
          environnement collaboratif où chaque membre peut exprimer son
          expertise pour amplifier notre action commune.
        </p>
      </div>
    </div>

    <!-- Membres -->
    <div id="team">
      <div class="mx-auto px-6 lg:px-8">
        <div class="mb-10">
          <span
            class="inline-flex items-center gap-1.5 text-xs md:text-sm font-medium text-green-700 uppercase tracking-widest mb-2"
          >
            Esprit d'équipe
          </span>
          <h2 class="text-xl md:text-3xl font-bold text-gray-900">
            Des acteurs engagés pour transformer le quotidien citoyen
          </h2>
        </div>
        <Membres team={members} />
      </div>
    </div>
  </section>
</Layout>
