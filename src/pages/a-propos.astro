---
import Layout from "~/layouts/PageLayout.astro";
import PageBanner from "~/components/widgets/PageBanner.astro";
import AboutUsSection from "~/components/widgets/apropos/AboutUs.astro";
import MissionsSection from "~/components/widgets/apropos/Missions.astro";
import ValuesSection from "~/components/widgets/apropos/Values.astro";
import AxesSection from "~/components/widgets/apropos/Axes.astro";
import CallToAction from "~/components/widgets/apropos/CallToAction.astro";
import AboutUs from "~/assets/images/Apropos.jpg";

const metadata = {
  title: "À propos - AfricTivistes CitizenLab Sénégal",
  description:
    "En savoir plus sur CitizenLab Sénégal, notre mission, notre équipe et nos valeurs.",
  ignoreTitleTemplate: true,  
};
---

<Layout metadata={metadata}>
  <PageBanner
    image={AboutUs}
    alt="À Propos de Nous"
    label="À propos"
    title="Renforcez la Participation Citoyenne au Sénégal"
    description="Découvrez notre mission, notre équipe et nos valeurs pour une démocratie participative plus inclusive."
  />

  <AboutUsSection />
  <MissionsSection />
  <ValuesSection />
  <AxesSection />
  <CallToAction />
</Layout>