---
import { Icon } from "astro-icon/components";
import Logo from "~/components/Logo.astro";
import ToggleMenu from "~/components/common/ToggleMenu.astro";
import Button from "~/components/ui/Button.astro"
import { getHomePermalink, trimSlash } from "~/utils/permalinks";
import type { CallToAction } from "~/types";

interface Link {
  text?: string;
  href?: string;
}

interface ActionLink extends CallToAction {}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<ActionLink>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  position?: string;
}

const {
  id = "header",
  links = [], 
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  position = "center",
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    "top-0 z-40 flex-none mx-auto w-full border-b border-gray-100/80 transition-[opacity] ease-in-out bg-white/95 backdrop-blur-sm",
  ]}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      "relative text-default py-3.5 px-4 md:px-6 mx-auto w-full md:flex md:justify-between md:items-center",
      {
        "max-w-7xl": !isFullWidth,
      },
    ]}
  >
    <!-- Logo + Toggle -->
    <div class:list={[{ "mr-auto rtl:mr-0 rtl:ml-auto": position === "right" }, "flex justify-between"]}>
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu />
      </div>
    </div>
    
    <!-- Navigation -->
    <nav
      class="items-center w-full md:w-auto hidden md:!flex text-default overflow-y-auto overflow-x-hidden md:overflow-y-visible md:overflow-x-auto md:mx-4"
      aria-label="Main navigation"
    >
      <!-- Séparateur mobile -->
      <div class="md:hidden border-t border-gray-100 my-2"></div>

      <ul class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-sm md:text-[0.8125rem] tracking-[0.01rem] font-medium">
        {
          Array.isArray(links) && links.map(({ text, href, links: childItems = [] }) => {
            const isChildActive = Array.isArray(childItems) && childItems.some(
              (child) => (child.href && currentPath) ? child.href === currentPath : false
            );
            const isActive = (href && currentPath) ? href === currentPath : false;
            const hasChildren = Array.isArray(childItems) && childItems.length > 0;
            
            return (
              <li class:list={[{ 
                "dropdown": hasChildren, 
                "aw-link-active": isChildActive 
              }, "group mobile-nav-item"]}>
                {hasChildren ? (
                  <>
                    {/* Desktop: lien avec hover */}
                    <a href={href || '#'} class="hidden md:flex">
                      <button 
                        class:list={[
                          "hover:text-green-700 dark:hover:text-white px-3 py-2.5 flex items-center whitespace-nowrap transition-colors duration-200", 
                          { "aw-link-active-text text-green-700": isChildActive } 
                        ]}
                      >
                        {text} <Icon name="tabler:chevron-down" class="w-3 h-3 ml-0.5 rtl:ml-0 rtl:mr-0.5 opacity-40" />
                      </button>
                    </a>

                    {/* Mobile: bouton accordion */}
                    <button 
                      class:list={[
                        "mobile-dropdown-toggle md:hidden w-full flex items-center justify-between px-3 py-3 rounded-lg hover:bg-gray-50 transition-colors",
                        { "text-green-700 bg-green-50": isChildActive }
                      ]}
                    >
                      <span class="font-medium">{text}</span>
                      <Icon name="tabler:chevron-down" class="mobile-chevron w-4 h-4 text-gray-400 transition-transform duration-200" />
                    </button>

                    {/* Liste unique : accordion mobile + hover desktop */}
                    <ul class="dropdown-menu mobile-dropdown-content
                      hidden
                      md:backdrop-blur-md dark:md:bg-dark rounded-lg md:absolute md:pl-0 font-medium md:bg-white/95 md:min-w-[200px] md:shadow-lg md:border md:border-gray-100 md:text-[0.8125rem]
                      md:!hidden
                      group-hover:md:!block
                    ">
                      {/* Mobile : bordure verte + padding */}
                      <div class="ml-3 pl-3 border-l-2 border-green-200 py-1 mb-1 md:ml-0 md:pl-0 md:border-l-0 md:py-0 md:mb-0">
                        {childItems.map(({ text: text2 = '', href: href2 = '' }) => (
                          <li>
                            <a
                              class:list={[
                                "block py-2 px-3 md:py-2.5 md:px-4 rounded-lg md:rounded-none first:md:rounded-t-lg last:md:rounded-b-lg text-[0.8125rem] text-gray-500 md:text-current hover:text-green-700 md:hover:bg-gray-50 hover:bg-green-50/50 md:hover:bg-gray-50 transition-colors duration-150 whitespace-nowrap",
                                { "text-green-700 font-semibold aw-link-active-text": (href2 && currentPath) ? href2 === currentPath : false }
                              ]}
                              href={href2}
                            >
                              {text2}
                            </a>
                          </li>
                        ))}
                      </div>
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      "hover:text-green-700 dark:hover:text-white px-3 py-2.5 md:py-2.5 flex items-center whitespace-nowrap transition-colors duration-200 rounded-lg hover:bg-gray-50 md:hover:bg-transparent",
                      { "aw-link-active-text text-green-700 bg-green-50 md:bg-transparent font-semibold": isActive }
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>

      <!-- CTA mobile -->
      <div class="md:hidden border-t border-gray-100 mt-3 pt-3 pb-1 px-1">
        {
          Array.isArray(actions) && actions.length > 0 && (
            actions.map((btnProps) => (
              <Button {...btnProps} class="w-full py-2.5 px-5 font-semibold shadow-none text-sm justify-center"/>
            ))
          )
        }
      </div>
    </nav>
    
    <!-- CTA desktop -->
    <div
      class:list={[
        { "ml-auto rtl:ml-0 rtl:mr-auto": position === "left" },
        "hidden md:self-center md:flex items-center md:mb-0 md:w-auto md:static justify-end",
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        {
          Array.isArray(actions) && actions.length > 0 && (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {actions.map((btnProps) => (
                <Button {...btnProps} class="ml-2 py-2 px-5 font-semibold shadow-none text-[0.8125rem] w-auto"/>
              ))}
            </span>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggles = document.querySelectorAll('.mobile-dropdown-toggle');

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const parent = toggle.closest('.mobile-nav-item');
        const content = parent?.querySelector('.mobile-dropdown-content');
        const chevron = toggle.querySelector('.mobile-chevron');

        // Fermer les autres dropdowns ouverts
        document.querySelectorAll('.mobile-nav-item').forEach((other) => {
          if (other !== parent) {
            other.querySelector('.mobile-dropdown-content')?.classList.add('hidden');
            const otherChevron = other.querySelector('.mobile-chevron');
            otherChevron?.classList.remove('rotate-180');
          }
        });

        // Toggle celui-ci
        content?.classList.toggle('hidden');
        chevron?.classList.toggle('rotate-180');
      });
    });

    // Empêcher les clics dans les sous-menus de fermer le menu principal
    const dropdownContents = document.querySelectorAll('.mobile-dropdown-content');
    dropdownContents.forEach((content) => {
      content.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    });
  });
</script>