---
import { Icon } from 'astro-icon/components';
import { getHomePermalink } from '~/utils/permalinks';
import Logo from "~/assets/images/logo_lg.png";
import { Image } from "astro:assets";

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative not-prose bg-gray-900']}>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Haut : Logo + colonnes de liens -->
    <div class="grid grid-cols-12 gap-8 py-12 border-b border-gray-800">
      <!-- Logo + description -->
      <div class="col-span-12 lg:col-span-4">
        <a class="inline-block mb-4" href={getHomePermalink()}>
          <Image src={Logo} alt="Logo" width={130} height={36} />
        </a>
        <p class="text-sm text-gray-400 leading-relaxed max-w-xs mb-5">
          Promouvoir la participation citoyenne et la démocratie participative par la technologie civique au Sénégal.
        </p>

        <!-- Réseaux sociaux -->
        {socialLinks?.length > 0 && (
          <div class="flex items-center gap-2">
            {socialLinks.map(({ ariaLabel, href, icon }) => (
              <a
                class="w-8 h-8 rounded-lg bg-gray-800 hover:bg-green-600 flex items-center justify-center text-gray-400 hover:text-white transition-all duration-200"
                aria-label={ariaLabel}
                href={href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {icon && <Icon name={icon} class="w-3.5 h-3.5" />}
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Colonnes de liens -->
      {links.map(({ title, links: columnLinks }) => (
        <div class="col-span-6 md:col-span-3 lg:col-span-2">
          <h4 class="text-xs font-semibold text-white uppercase tracking-wider mb-4">
            {title}
          </h4>
          {columnLinks && Array.isArray(columnLinks) && columnLinks.length > 0 && (
            <ul class="space-y-2.5">
              {columnLinks.map(({ text, href, ariaLabel }) => (
                <li>
                  <a
                    class="text-sm text-gray-400 hover:text-green-400 transition-colors duration-200"
                    href={href}
                    aria-label={ariaLabel}
                  >
                    <Fragment set:html={text} />
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <!-- Bas : copyright + liens secondaires -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 py-6">
      <div class="text-xs text-gray-500">
        <Fragment set:html={footNote} />
      </div>

      {secondaryLinks.length > 0 && (
        <div class="flex items-center gap-4">
          {secondaryLinks.map(({ text, href }) => (
            <a
              class="text-xs text-gray-500 hover:text-gray-300 transition-colors duration-200"
              href={href}
              set:html={text}
            />
          ))}
        </div>
      )}
    </div>

  </div>
</footer>