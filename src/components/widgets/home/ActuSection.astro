---
import { FaArrowRightLong } from "react-icons/fa6";
import { getLatestActualites } from "~/utils/api";
import {HiArrowRight} from "react-icons/hi";

const posts = await getLatestActualites(3);

const newsItems = posts.map((post: any, index: number) => {
  return {
    category: post.categories?.nodes?.[0]?.name ?? "Actualité",
    title: post.title,
    description: post.excerpt?.replace(/<[^>]+>/g, "").trim(),
    image: post.featuredImage?.node?.mediaItemUrl,
    alt: post.featuredImage?.node?.altText ?? post.title,
    link: `/news/${post.slug}`,
    variant: index === 0 ? "main" : index === 1 ? "split" : "small",
    icon: FaArrowRightLong,
  };
});
---

<section class="bg-gray-100/90 backdrop-blur-sm py-16 md:py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- En-tête -->
    <div class="mx-auto mb-14 space-y-6 text-center md:mb-16 lg:mb-20">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900">
        
        Actualités et <span class="text-green-600">médias</span>
      </h2>

      <p
        class="text-muted-foreground text-gray-500 max-w-xl text-center mx-auto"
      >
        Restez informés de nos dernières initiatives et événements
      </p>

      <div class="mx-auto h-1 w-20 rounded-full bg-green-500"></div>

    </div>

    <!-- Grille -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 mb-10">
      {newsItems.map((item: any) =>
        item.variant === "main" ? (
          <!-- Carte principale -->
          <a href={item.link} class="lg:col-span-7 lg:row-span-2 relative rounded-2xl overflow-hidden group min-h-[380px] md:min-h-[440px] flex flex-col justify-end">
            <img
              src={item.image}
              alt={item.alt}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>

            <div class="relative z-10 p-6 text-white">
              <span class="inline-block text-[11px] font-semibold bg-green-600 text-white px-3 py-1 rounded-full uppercase tracking-wide mb-3">
                {item.category}
              </span>
              <h3 class="text-lg md:text-xl font-bold leading-snug mb-2 line-clamp-2">
                {item.title}
              </h3>
              {item.description && (
                <p class="text-sm text-gray-300 leading-relaxed line-clamp-2 mb-4">
                  {item.description}
                </p>
              )}
              <span class="inline-flex items-center justify-center w-9 h-9 bg-green-600 group-hover:bg-green-700 rounded-full transition-colors">
                <item.icon className="w-4 h-4 text-white" />
              </span>
            </div>
          </a>
        ) : item.variant === "split" ? (
          <!-- Carte split -->
          <a href={item.link} class="lg:col-span-5 relative rounded-2xl overflow-hidden group border border-gray-100 bg-[#f0ead6] flex flex-col sm:flex-row">
            <div class="flex-1 p-5 flex flex-col">
              <span class="text-[10px] font-semibold text-gray-500 uppercase tracking-wide mb-2">
                {item.category}
              </span>
              <h3 class="text-muted-foreground font-bold text-gray-900 leading-snug line-clamp-3 flex-1 group-hover:text-green-800 transition-colors">
                {item.title}
              </h3>
              <span class="inline-flex items-center justify-center w-8 h-8 bg-green-600 group-hover:bg-green-700 rounded-full transition-colors mt-3">
                <item.icon className="w-3.5 h-3.5 text-white" />
              </span>
            </div>
            <div class="sm:w-[45%] relative min-h-[160px]">
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </a>
        ) : (
          <!-- Carte petite overlay -->
          <a href={item.link} class="lg:col-span-5 relative rounded-2xl overflow-hidden group min-h-[180px] flex flex-col justify-end">
            <img
              src={item.image}
              alt={item.alt}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

            <span class="absolute top-3 left-3 z-10 inline-block text-[10px] font-semibold bg-white/90 backdrop-blur-sm text-gray-800 px-2.5 py-1 rounded-full uppercase tracking-wide">
              {item.category}
            </span>

            <div class="relative z-10 p-5 text-white">
              <h3 class="text-sm font-bold leading-snug line-clamp-2 mb-3">
                {item.title}
              </h3>
              <span class="inline-flex items-center justify-center w-8 h-8 bg-green-600 group-hover:bg-green-700 rounded-full transition-colors">
                <item.icon className="w-3.5 h-3.5 text-white" />
              </span>
            </div>
          </a>
        )
      )}
    </div>

    <!-- CTA -->
    <div class="text-center">
      <a
        href="/news"
        class="inline-flex items-center gap-2 text-sm font-semibold text-green-700 hover:text-green-800 transition-colors group"
      >
        Voir toutes les actualités
        <HiArrowRight className="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
    
  </div>
</section>