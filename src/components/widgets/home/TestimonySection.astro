---
import { Image } from "astro:assets";
import testimony from "~/assets/images/testimonyBg.jpg";
import { FaQuoteRight, FaChevronLeft, FaChevronRight } from "react-icons/fa";

const testimonials = [
  {
    quote:
      "Avec CitizenLab, l'accès aux missions d'impact est devenu simple et notre expertise mieux valorisée. Notre communauté grandit avec des projets concrets et mesurables.",
    author: "Hamidou THIAW",
    role: "Municipalité de Dakar",
    initial: "H",
  },
  {
    quote:
      "Une plateforme exceptionnelle qui facilite vraiment la participation citoyenne. Les résultats ont dépassé toutes nos espérances et l'engagement des citoyens a été remarquable.",
    author: "Marie SECK",
    role: "Directrice Innovation, Ville de Rufisque",
    initial: "M",
  },
  {
    quote:
      "L'équipe CitizenLab nous a accompagné tout au long du projet. Les fonctionnalités sont exactement ce dont nous avions besoin pour impliquer nos citoyens dans les décisions locales.",
    author: "Ahmed DIOP",
    role: "Conseiller municipal, Thies",
    initial: "A",
  },
];
---

<section class="bg-white/80 backdrop-blur-sm py-16 md:py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">

      <!-- Colonne gauche — Image + carte témoignage -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden h-full">
          <Image
            src={testimony}
            class="w-full h-full min-h-[420px] object-cover"
            alt="testimony"
          />
        </div>

        <!-- Carte flottante -->
        <div class="absolute bottom-5 left-5 right-5">
          <div class="bg-white/95 backdrop-blur-sm rounded-xl shadow-lg p-5 border border-gray-100">
            <blockquote
              id="testimonial-quote"
              class="text-sm text-gray-700 leading-relaxed mb-4"
            >
              "{testimonials[0].quote}"
            </blockquote>

            <div class="flex items-center gap-3">
              <div
                id="testimonial-initial"
                class="w-10 h-10 rounded-full bg-green-50 border border-green-200 flex items-center justify-center"
              >
                <span class="text-sm font-bold text-green-800">{testimonials[0].initial}</span>
              </div>
              <div>
                <p id="testimonial-author" class="text-sm font-semibold text-gray-900">
                  {testimonials[0].author}
                </p>
                <p id="testimonial-role" class="text-xs text-gray-500">
                  {testimonials[0].role}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Colonne droite — Titre + navigation -->
      <div class="bg-[#e8e0cc]/80 backdrop-blur-sm rounded-2xl p-8 lg:p-10 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-semibold text-gray-600 uppercase tracking-wide border border-gray-400/50 px-3 py-1.5 rounded-full">
              Témoignages
            </span>
            <div class="w-10 h-10 bg-green-700 rounded-full flex items-center justify-center">
              <FaQuoteRight className="w-4 h-4 text-white" />
            </div>
          </div>

          <h2 class="text-2xl lg:text-3xl font-bold text-green-800 leading-tight">
            Un partenaire de confiance pour relever tous vos défis
          </h2>
        </div>

        <div class="flex items-center justify-between mt-8">
          <a
            href="#"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold bg-green-700 text-white hover:bg-green-800 rounded-full transition-colors"
          >
            Lire les témoignages
          </a>

          <div class="flex items-center gap-2">
            <button
              id="prev-btn"
              class="rounded-full bg-white hover:bg-green-700 hover:text-white h-9 w-9 inline-flex items-center justify-center border border-gray-200 transition-all"
              aria-label="Témoignage précédent"
            >
              <FaChevronLeft className="w-3.5 h-3.5" />
            </button>
            <button
              id="next-btn"
              class="rounded-full bg-white hover:bg-green-700 hover:text-white h-9 w-9 inline-flex items-center justify-center border border-gray-200 transition-all"
              aria-label="Témoignage suivant"
            >
              <FaChevronRight className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script define:vars={{ testimonials }}>
  let currentIndex = 0;
  let autoSlide;

  const quoteEl = document.getElementById("testimonial-quote");
  const initialEl = document.querySelector("#testimonial-initial span");
  const authorEl = document.getElementById("testimonial-author");
  const roleEl = document.getElementById("testimonial-role");

  quoteEl.style.transition = "opacity 0.3s ease-in-out";

  const updateTestimonial = () => {
    const current = testimonials[currentIndex];

    quoteEl.style.opacity = "0";

    setTimeout(() => {
      quoteEl.textContent = `"${current.quote}"`;
      initialEl.textContent = current.initial;
      authorEl.textContent = current.author;
      roleEl.textContent = current.role;

      quoteEl.style.opacity = "1";
    }, 200);
  };

  const next = () => {
    currentIndex = (currentIndex + 1) % testimonials.length;
    updateTestimonial();
  };

  const prev = () => {
    currentIndex = (currentIndex - 1 + testimonials.length) % testimonials.length;
    updateTestimonial();
  };

  const startAutoSlide = () => {
    clearInterval(autoSlide);
    autoSlide = setInterval(next, 5000); // toutes les 5 secondes
  };

  document.getElementById("next-btn").addEventListener("click", () => {
    next();
    startAutoSlide();
  });

  document.getElementById("prev-btn").addEventListener("click", () => {
    prev();
    startAutoSlide();
  });

  // Lancement automatique
  startAutoSlide();
</script>