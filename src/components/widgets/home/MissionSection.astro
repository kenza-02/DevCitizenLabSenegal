---
import { HiOutlineLightBulb } from "react-icons/hi";
import { FaBriefcase, FaUsers, FaHandshake, FaChartLine, FaAward, FaGlobe } from "react-icons/fa";

const stats = [
  {
    id: 1,
    title: "Jeunes formés",
    amount: "150+",
    description:
      "aux outils numériques pour s'engager activement dans la transformation de leur communauté",
    icon: FaUsers,
  },
  {
    id: 2,
    title: "Projets réalisés",
    amount: "10",
    description:
      "des idées transformées en vraies solutions concrètes qui changent des vies",
    icon: HiOutlineLightBulb,
  },
  {
    id: 3,
    title: "Partenariats",
    amount: "3",
    description:
      "avec des alliés engagés pour amplifier notre impact et créer le changement",
    icon: FaHandshake,
  },
];

const icons = [FaBriefcase, FaUsers, FaHandshake, FaChartLine, FaAward, FaGlobe];

---

<section
  class="relative overflow-hidden bg-white/90 backdrop-blur-sm py-16 md:py-20 lg:py-24"
>
  <!-- Formes décoratives -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="shape-blob absolute -top-40 -right-40 h-96 w-96 rounded-full bg-gradient-to-br from-green-200/30 to-green-300/20 blur-3xl"
    >
    </div>

    <div
      class="shape-blob absolute -bottom-40 -left-40 h-[500px] w-[500px] rounded-full bg-gradient-to-br from-red-200/20 to-yellow-200/20 blur-3xl"
    >
    </div>

    <div
      class="shape-blob absolute top-1/2 left-1/3 h-64 w-64 rounded-full bg-gradient-to-br from-yellow-200/20 to-green-200/20 blur-2xl"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <!-- En-tête -->
    <div class="mx-auto mb-14 space-y-6 text-center md:mb-16 lg:mb-20">

      <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900">
        Pourquoi
        <span class="text-green-600">CitizenLab Sénégal</span>
        ?
      </h2>

      <p
        class="text-muted-foreground text-gray-500 max-w-xl text-center mx-auto"
      >
        Nous réunissons citoyens et innovateurs pour créer des solutions
        numériques à fort impact.
      </p>

      <div class="mx-auto h-1 w-20 rounded-full bg-green-500"></div>

    </div>

    <!-- Statistiques -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
  {
    stats.map((stat, index) => {
      const IconComponent = icons[index % icons.length];
      return (
        <div class="relative rounded-2xl bg-white border border-gray-100 hover:border-green-200 p-5 md:p-6 transition-colors duration-200 overflow-hidden">
          {/* Accent vert en haut */}
          <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-green-600 to-green-400 rounded-t-2xl"></div>
 
          {/* Chiffre + Icône */}
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-3xl md:text-4xl font-bold text-green-700 leading-none tracking-tight">
              {stat.amount}
            </h3>
            <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center text-green-600 shrink-0">
              <IconComponent className="w-4 h-4" />
            </div>
          </div>
 
          {/* Titre */}
          <h4 class="font-semibold text-green-800 mb-1">
            {stat.title}
          </h4>
 
          {/* Description */}
          {stat.description && (
            <p class="text-sm text-gray-400 leading-relaxed">
              {stat.description}
            </p>
          )}
        </div>
      );
    })
  }
</div>

    <!-- CTA -->
    <div class="mt-14 text-center md:mt-16">
      <a
        href="/a-propos"
        class="inline-flex items-center gap-2 px-6 py-2.5 text-sm rounded-lg bg-green-600 text-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:bg-green-700 hover:shadow-2xl"
      >
        En savoir plus

        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
