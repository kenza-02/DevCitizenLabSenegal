---
import { Image } from "astro:assets";
import First from "~/assets/images/image-1.jpg";
import Second from "~/assets/images/image-2.jpg";
import Third from "~/assets/images/third.jpeg";
---

<section class="relative h-[85vh] min-h-[500px] flex items-center overflow-hidden">
  <!-- Carousel background -->
  <div class="absolute inset-0 w-full h-full overflow-hidden">
    <div
      id="carousel-track"
      class="flex w-full h-full transition-transform duration-1000 ease-in-out"
    >
      <div class="flex-shrink-0 w-full h-full">
        <Image
          src={First}
          alt="Citoyens engagés au Sénégal"
          class="w-full h-full object-cover animate-ken-burns"
        />
      </div>
      <div class="flex-shrink-0 w-full h-full">
        <Image
          src={Second}
          alt="Atelier civic tech"
          class="w-full h-full object-cover animate-ken-burns"
        />
      </div>
      <div class="flex-shrink-0 w-full h-full">
        <Image
          src={Third}
          alt="Événement participatif"
          class="w-full h-full object-cover animate-ken-burns"
        />
      </div>
    </div>

    <!-- Overlay -->
    <div class="absolute inset-0 bg-gradient-to-br from-black/70 via-black/50 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
  </div>

  <!-- Particules décoratives -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="particle absolute top-20 left-10 w-4 h-4 bg-green-400/40 rounded-full"></div>
    <div class="particle absolute top-40 right-20 w-6 h-6 bg-red-400/30 rounded-full"></div>
    <div class="particle absolute bottom-32 left-1/4 w-4 h-4 bg-yellow-400/40 rounded-full"></div>
    <div class="particle absolute top-1/3 right-1/3 w-2 h-2 bg-green-300/30 rounded-full"></div>
  </div>

  <!-- Contenu principal -->
  <div class="relative z-10 w-full max-w-5xl mx-auto px-6 lg:px-8">
    <div class="text-center text-white space-y-6">
      <!-- Badge -->
      <div>
        <span class="inline-flex px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-xs font-semibold tracking-wider uppercase text-white/90">
          🇸🇳 Civic Tech au Sénégal
        </span>
      </div>

      <!-- Titre principal -->
      <h1 class="text-3xl sm:text-4xl lg:text-6xl font-bold leading-tight tracking-tight">
        <span class="block mb-1">Votre plateforme</span>
        <span class="block mb-1">d'innovations <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-red-300">citoyennes</span></span>
        <span class="block">au <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-green-300">Sénégal</span></span>
      </h1>

      <!-- Sous-titre -->
      <p class="max-w-2xl mx-auto text-xl sm:text-lg text-center text-gray-200 leading-relaxed">
        Promouvoir la <span class="font-semibold text-white">participation citoyenne</span> et la
        <span class="font-semibold text-white">démocratie participative</span> par l'utilisation
        de la <span class="font-semibold text-white">technologie civique</span>
      </p>

      <!-- Boutons CTA -->
      <div class="flex flex-col sm:flex-row justify-center gap-4 pt-2">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-7 py-3 text-sm font-semibold text-white bg-green-600 hover:bg-green-700 rounded-xl shadow-lg shadow-green-600/20 hover:shadow-green-600/30 transition-all duration-300"
        >
          Rejoignez-nous
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>

        <a
          href="/a-propos"
          class="inline-flex items-center justify-center gap-2 px-7 py-3 text-sm font-semibold text-white bg-white/10 backdrop-blur-sm border border-white/25 hover:bg-white/20 rounded-xl transition-all duration-300"
        >
          En savoir plus
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Indicateurs carousel -->
  <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 z-20 flex gap-2">
    <button
      class="carousel-indicator w-8 h-1 bg-white/30 hover:bg-white/60 rounded-full transition-all duration-300 active"
      data-slide="0"
      aria-label="Slide 1"
    ></button>
    <button
      class="carousel-indicator w-8 h-1 bg-white/30 hover:bg-white/60 rounded-full transition-all duration-300"
      data-slide="1"
      aria-label="Slide 2"
    ></button>
    <button
      class="carousel-indicator w-8 h-1 bg-white/30 hover:bg-white/60 rounded-full transition-all duration-300"
      data-slide="2"
      aria-label="Slide 3"
    ></button>
  </div>
</section>

<style>
  @keyframes ken-burns {
    0% { transform: scale(1); }
    100% { transform: scale(1.08); }
  }

  .animate-ken-burns {
    animation: ken-burns 18s ease-out infinite alternate;
  }

  .carousel-indicator.active {
    background: white;
    width: 2rem;
  }

  @keyframes float-particle {
    0%, 100% {
      transform: translate(0, 0);
      opacity: 0.4;
    }
    50% {
      transform: translate(15px, -15px);
      opacity: 0.6;
    }
  }

  .particle {
    animation: float-particle 10s ease-in-out infinite;
  }
  .particle:nth-child(2) { animation-delay: -3s; animation-duration: 12s; }
  .particle:nth-child(3) { animation-delay: -5s; animation-duration: 14s; }
  .particle:nth-child(4) { animation-delay: -7s; animation-duration: 11s; }
</style>

<script>
  let currentSlide = 0;
  const slides = 3;
  const track = document.getElementById('carousel-track');
  const indicators = document.querySelectorAll('.carousel-indicator');

  function goToSlide(index: number) {
    currentSlide = index;
    if (track) {
      track.style.transform = `translateX(-${currentSlide * 100}%)`;
    }
    indicators.forEach((indicator, i) => {
      indicator.classList.toggle('active', i === currentSlide);
    });
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % slides;
    goToSlide(currentSlide);
  }

  let autoplay = setInterval(nextSlide, 5000);

  indicators.forEach((indicator, index) => {
    indicator.addEventListener('click', () => {
      goToSlide(index);
      clearInterval(autoplay);
      autoplay = setInterval(nextSlide, 5000);
    });
  });
</script>