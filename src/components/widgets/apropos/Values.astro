---
import { FaHandHoldingHeart, FaUsers, FaEye, FaHandshake, FaLightbulb } from "react-icons/fa";

const valeurs = [
  {
    num: "01",
    titre: "Engagement citoyen",
    description: "Participation active des citoyens dans la gouvernance locale et nationale. Nous croyons en la force de l'action collective pour transformer la société.",
    icon: FaHandHoldingHeart,
    featured: true,
  },
  {
    num: "02",
    titre: "Inclusion",
    description: "Accès équitable au numérique pour tous les citoyens, sans distinction.",
    icon: FaUsers,
  },
  {
    num: "03",
    titre: "Transparence",
    description: "Clarté et ouverture dans toutes nos actions et décisions.",
    icon: FaEye,
  },
  {
    num: "04",
    titre: "Collaboration",
    description: "Travail en partenariat avec les acteurs de la société civile.",
    icon: FaHandshake,
  },
  {
    num: "05",
    titre: "Innovation",
    description: "Créativité et adoption de nouvelles technologies citoyennes.",
    icon: FaLightbulb,
  },
];

const featured = valeurs.find((v) => v.featured);
const others = valeurs.filter((v) => !v.featured);
---

<section class="py-16 bg-white/80 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="flex flex-col items-center justify-center gap-4 mb-10">
      <div class="text-center">
        <span class="inline-flex text-center items-center gap-1.5 text-xs md:text-sm font-medium text-green-700 uppercase tracking-widest mb-2">
          Nos valeurs
        </span>
        <h2 class="text-2xl text-center md:text-3xl lg:text-4xl font-bold text-gray-900">
          Ce qui nous <span class="text-green-600">anime</span>
        </h2>
      </div>
      
        <div class="mx-auto h-1 w-20 rounded-full bg-green-500"></div>
    </div>

    <!-- Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

      <!-- Carte featured -->
      {featured && (
        <div class="lg:row-span-2 relative bg-gradient-to-br from-green-800 to-green-700 rounded-2xl p-6 md:p-8 flex flex-col justify-between min-h-[280px] lg:min-h-0 overflow-hidden">
          <!-- Cercles décoratifs -->
          <div class="absolute -top-10 -right-10 w-28 h-28 rounded-full bg-white/5"></div>
          <div class="absolute -bottom-8 -left-8 w-20 h-20 rounded-full bg-white/[0.03]"></div>

          <div class="relative z-10 mt-auto">
            <div class="w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center mb-4">
              <featured.icon className="w-5 h-5 text-white" />
            </div>
            <h3 class="text-lg md:text-xl font-bold text-white mb-2">
              {featured.titre}
            </h3>
            <p class="text-sm text-white/70 leading-relaxed max-w-md">
              {featured.description}
            </p>
          </div>
        </div>
      )}

      <!-- Grille des autres valeurs -->
      {others.map((valeur) => (
        <div class="bg-white border border-gray-100 hover:border-green-200 rounded-2xl p-5 flex flex-col transition-colors duration-200">
          <div class="flex items-center justify-between mb-3">
            <div class="w-9 h-9 rounded-lg bg-green-50 border border-green-100 flex items-center justify-center text-green-700">
              <valeur.icon className="w-4 h-4" />
            </div>
          </div>
          <h3 class="text-sm font-bold text-gray-900 mb-1">
            {valeur.titre}
          </h3>
          <p class="text-sm text-gray-500 leading-relaxed">
            {valeur.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>