---
import { FaArrowRightLong } from "react-icons/fa6";
---

<div class="max-w-7xl bg-white/80 backdrop-blur-sm mx-auto px-6 lg:px-8 py-16">
  <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-green-700 to-green-800">
    <!-- Cercles décoratifs -->
    <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/5"></div>
    <div class="absolute -bottom-8 -left-8 w-28 h-28 rounded-full bg-white/[0.03]"></div>

    <div class="relative z-10 px-6 md:px-12 py-12 md:py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div class="max-w-xl">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">
          Rejoignez notre communauté
        </h2>
        <p class="text-sm text-green-200 leading-relaxed">
          Ensemble, construisons un Sénégal numérique inclusif, transparent et participatif.
        </p>
      </div>

      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-white text-green-800 text-sm font-semibold rounded-lg hover:bg-green-50 transition-colors duration-200 shrink-0"
      >
        Nous contacter
        <FaArrowRightLong className="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</div>