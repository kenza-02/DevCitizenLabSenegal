---
import { GiTeacher } from "react-icons/gi";
import { FaLightbulb, FaGlobe } from "react-icons/fa";
import { FaArrowRightLong } from "react-icons/fa6";

const axes = [
  {
    num: "01",
    title: "Formation et sensibilisation",
    description: "Renforcer les capacités numériques des citoyens et les sensibiliser aux enjeux de la participation citoyenne et de la gouvernance ouverte.",
    icon: GiTeacher,
  },
  {
    num: "02",
    title: "Innovation, Digitalisation et Transparence",
    description: "Développer des outils numériques innovants pour améliorer la transparence publique et faciliter l'accès à l'information pour tous.",
    icon: FaLightbulb,
  },
  {
    num: "03",
    title: "Infrastructures, Accessibilité et Adoption",
    description: "Favoriser l'accès aux infrastructures numériques et accompagner l'adoption des technologies par les communautés et les institutions.",
    icon: FaGlobe,
  },
];
---

<section class="bg-gray-50/90 backdrop-blur-sm py-16">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="flex flex-col items-center justify-center gap-4 mb-10">
      <div class="text-center">
        <span class="inline-flex text-center items-center gap-1.5 text-xs md:text-sm font-medium text-green-700 uppercase tracking-widest mb-2">
          Nos axes <span class="text-green-600">d'intervention</span>
        </span>
        <h2 class="text-2xl text-center md:text-3xl lg:text-4xl font-bold text-gray-900">
          Ce qui nous <span class="text-green-600">guide</span>
        </h2>
      </div>
        <div class="mx-auto h-1 w-20 rounded-full bg-green-500"></div>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {axes.map((axe) => (
        <div class="relative bg-white border border-gray-100 hover:border-green-200 rounded-2xl p-6 flex flex-col transition-colors duration-200 overflow-hidden group">
          <!-- Accent bar -->
          <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-green-600 to-green-400 rounded-t-2xl"></div>

          <!-- Numéro + Icône -->
          <div class="flex items-center justify-between mb-5">
            <div class="w-11 h-11 rounded-xl bg-green-50 border border-green-100 flex items-center justify-center text-green-700">
              <axe.icon className="w-5 h-5" />
            </div>
            <span class="text-3xl font-bold text-green-100 leading-none select-none">
              {axe.num}
            </span>
          </div>

          <!-- Contenu -->
          <h3 class="text-base font-bold text-gray-900 mb-2 group-hover:text-green-800 transition-colors">
            {axe.title}
          </h3>
          <p class="text-xs md:text-sm text-gray-500 leading-relaxed flex-1 mb-5">
            {axe.description}
          </p>

          <!-- Lien -->
          <div class="pt-4 border-t border-gray-50">
            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 group-hover:text-green-900 transition-colors cursor-pointer">
              En savoir plus
              <FaArrowRightLong className="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>