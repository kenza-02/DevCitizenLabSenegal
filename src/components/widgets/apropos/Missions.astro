---
import { Image } from "astro:assets";
import First from "~/assets/images/first.jpg";
import { IoMdCheckmark } from "react-icons/io";

const missionPoints = [
  "Renforcer les capacités des jeunes, des femmes et des acteurs de la société civile",
  "Utiliser le numérique comme outil d'engagement citoyen et de redevabilité",
  "Favoriser la co-création de solutions Civic Tech innovantes",
];
---

<div class="bg-gradient-to-r from-yellow-50/90 to-orange-50/90 b py-12 md:py-16 lg:py-20 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-8 lg:gap-12 items-center">

      <!-- Texte -->
      <div class="md:col-span-3 space-y-6">

        <div class="inline-flex">
          <span class="text-xs md:text-sm font-medium uppercase text-yellow-900">
            NOTRE MISSION
          </span>
        </div>

        <h2 class="text-2xl md:text-3xl lg:text-4xl font-black leading-7 text-gray-900">
          Transformer par le
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-600 to-orange-600">
            numérique
          </span>
        </h2>

        <div class="space-y-5">

          {missionPoints.map((point) => (
            <div
              class="flex items-start gap-4 group hover:translate-x-2 transition-transform duration-300"
            >
              <div
                class="flex-shrink-0 mt-1 p-2 bg-yellow-200 rounded-lg group-hover:bg-yellow-300 transition-colors"
              >
                <IoMdCheckmark className="w-4 h-4 md:w-5 md:h-5 text-yellow-800" />
              </div>

              <p class="text-base md:text-lg leading-7 text-gray-700">
                {point}
              </p>
            </div>
          ))}

        </div>

      </div>

      <!-- Image -->
      <div class="md:col-span-2 flex justify-center">
        <Image
          src={First}
          alt="Notre Mission"
          class="w-full max-w-md md:max-w-none rounded-3xl shadow-2xl hover:scale-105 transition-transform duration-300"
        />
      </div>

    </div>
  </div>
</div>